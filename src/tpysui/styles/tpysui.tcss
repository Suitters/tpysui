/* ══════════════════════════════════════════════════════════
   tpysui.tcss — consolidated stylesheet
   Sections: App Layout, ActiveStateBar, ConfigScreen,
             Modals (Startup, Group, Profile, Confirm,
             Address×4, Chooser)
   ══════════════════════════════════════════════════════════ */

/* ── App Layout ─────────────────────────────────────────── */

#main-row       { height: 1fr; }
#sidebar-panel  { width: 30; border-right: solid $primary; background: $panel; }
#sidebar-header { width: 1fr; height: 1; background: $surface-lighten-2; color: $text; text-style: bold; content-align: center middle; }
#sidebar        { width: 1fr; height: 1fr; padding-top: 1; }
#content        { width: 1fr; height: 100%; }

#screen-dashboard,
#screen-config,
#screen-reads,
#screen-writes,
#screen-tx,
#screen-uci {
    width: 1fr;
    height: 100%;
}

DataTable > .datatable--cursor {
    background: transparent;
    color: $text;
    text-style: none;
}
DataTable:focus > .datatable--cursor {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    text-style: $block-cursor-text-style;
}

/* ── Global Button Rules ─────────────────────────────────── */

Button {
    height: 1;
    padding: 0 2;
    border: none;
}

Button#btn-cancel,
Button#btn_cancel {
    background: $surface-lighten-2;
    color: $text;
}

Button:disabled {
    background: $background;
    color: $text-disabled;
    opacity: 0.6;
}

/* ── ActiveStateBar ──────────────────────────────────────── */

ActiveStateBar {
    height: 4;
    border-bottom: solid $primary;
}
ActiveStateBar #title-row {
    height: 2;
    background: $primary;
    align: center middle;
}
ActiveStateBar #title-text {
    text-style: bold;
    color: $text;
    width: auto;
}
ActiveStateBar #state-row {
    height: 1;
    background: $surface;
    align: left middle;
    padding: 0 2;
}
ActiveStateBar .state-btn {
    width: auto;
    height: 1;
    color: $accent;
    background: transparent;
    padding: 0 1 0 0;
}
ActiveStateBar .state-btn:hover {
    color: $text;
    background: $boost;
}
ActiveStateBar .state-key {
    width: auto;
    color: $text-muted;
    padding: 0 0 0 0;
}
ActiveStateBar .state-label {
    width: auto;
    color: $text-muted;
    padding: 0 1 0 0;
}
ActiveStateBar .sep {
    color: $primary;
    width: 3;
}

/* ── DashboardScreen ─────────────────────────────────────── */

DashboardScreen {
    layout: vertical;
    height: 1fr;
    padding: 0 1;
}

#dashboard_body {
    height: 1fr;
    layout: vertical;
}

#chain_strip {
    height: 1;
    align: left middle;
    background: $boost;
    padding: 0 1;
    margin-bottom: 1;
}

#chain_strip Static {
    width: auto;
    padding: 0 1;
    color: $text;
}

.dash_sep {
    color: $primary;
    padding: 0;
}

#dashboard_panels {
    height: 1fr;
}

.dash_pane {
    height: 100%;
    border: solid $primary;
}

.dash_pane_title {
    dock: top;
    height: 1;
    background: $boost;
    padding: 0 1;
    color: $text-muted;
}

#dash_gas_pane { width: 1.4fr; }
#dash_obj_pane { width: 1fr; }
#dash_bal_pane { width: 2fr; }

DashboardScreen ListView {
    height: 1fr;
    scrollbar-size-horizontal: 0;
}

DashboardScreen ListItem {
    padding: 0 1;
}

DashboardScreen #gas_list ListItem > Horizontal {
    height: 1;
}

DashboardScreen .gas-item-id {
    width: 1fr;
}

DashboardScreen .gas-item-bal {
    width: auto;
    color: $success;
    text-align: right;
}

#bal_text {
    height: 1fr;
}

#bal_text {
    height: 1fr;
    border: none;
}

/* ── ConfigScreen ────────────────────────────────────────── */

ConfigScreen {
    layout: horizontal;
    width: 1fr;
    height: 1fr;
}
ConfigScreen .pane {
    height: 100%;
    border: solid $primary;
}
ConfigScreen #pane-groups    { width: 1fr; }
ConfigScreen #pane-profiles  { width: 2fr; }
ConfigScreen #pane-addresses { width: 2fr; }
ConfigScreen .pane-title {
    dock: top;
    height: 1;
    background: $boost;
    padding: 0 1;
}
ConfigScreen DataTable { scrollbar-size-horizontal: 0; }
ConfigScreen .pane DataTable {
    height: 1fr;
    scrollbar-size-horizontal: 0;
}

/* ── StartupModal ────────────────────────────────────────── */

StartupModal { align: center middle; }
StartupModal #dialog {
    width: 70;
    height: auto;
    max-height: 44;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}
StartupModal #dialog-title { text-style: bold; margin-bottom: 1; }
StartupModal #new-section    { display: none; height: auto; }
StartupModal #new-folder-row { height: auto; }
StartupModal #new-folder-row Input  { width: 1fr; }
StartupModal #new-folder-row Button { width: auto; margin-left: 1; }
StartupModal .field-label    { color: $text-muted; margin-top: 1; }
StartupModal #choice-buttons  { align: center middle; height: auto; margin-top: 1; }
StartupModal #action-buttons  { align: right middle;  height: auto; margin-top: 1; }
StartupModal Button { margin: 0 1; }

/* ── GroupModal ──────────────────────────────────────────── */

GroupModal { align: center middle; }
GroupModal #dialog {
    width: 70;
    max-height: 38;
    border: thick $primary;
    background: $surface;
}
GroupModal #dialog VerticalScroll { padding: 1 2; border: none; }
GroupModal #dialog-title { text-style: bold; margin-bottom: 1; }
GroupModal .section      { margin-top: 1; }
GroupModal .field-label  { color: $text-muted; }
GroupModal #std-section    { display: block; }
GroupModal #custom-section { display: none; }
GroupModal .radio-box {
    border: solid $accent;
    padding: 0 1;
    height: auto;
    margin-bottom: 1;
}
GroupModal .radio-box RadioSet { border: none; padding: 0; }
GroupModal Collapsible       { margin: 0; padding: 0; }
GroupModal CollapsibleTitle  { padding: 0 1; background: $boost; }
GroupModal .list-scroll      { max-height: 8; border: none; }
GroupModal #buttons          { align: right middle; height: auto; margin-top: 1; }
GroupModal Button            { margin-left: 1; }

/* ── ProfileModal ────────────────────────────────────────── */

ProfileModal { align: center middle; }
ProfileModal #dialog {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}
ProfileModal #modal-title { text-style: bold; margin-bottom: 1; }
ProfileModal Label         { color: $text-muted; }
ProfileModal Input         { margin-bottom: 1; }
ProfileModal #buttons      { align: right middle; height: auto; margin-top: 1; }
ProfileModal Button        { margin-left: 1; }

/* ── ConfirmModal ────────────────────────────────────────── */

ConfirmModal { align: center middle; }
ConfirmModal #dialog {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}
ConfirmModal #message { margin-bottom: 1; }
ConfirmModal #buttons { align: right middle; height: auto; }
ConfirmModal Button   { margin-left: 1; }

/* ── AddressChoiceModal ──────────────────────────────────── */

AddressChoiceModal { align: center middle; }
AddressChoiceModal #dialog {
    width: 40;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}
AddressChoiceModal #title   { text-style: bold; margin-bottom: 1; }
AddressChoiceModal #buttons { align: center middle; height: auto; margin-top: 1; }
AddressChoiceModal Button   { margin: 0 1; }

/* ── AliasInputModal ─────────────────────────────────────── */

AliasInputModal { align: center middle; }
AliasInputModal #dialog {
    width: 50;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}
AliasInputModal #modal-title { text-style: bold; margin-bottom: 1; }
AliasInputModal Label        { color: $text-muted; }
AliasInputModal #buttons     { align: right middle; height: auto; margin-top: 1; }
AliasInputModal Button       { margin-left: 1; }

/* ── ImportAddressModal ──────────────────────────────────── */

ImportAddressModal { align: center middle; }
ImportAddressModal #dialog {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}
ImportAddressModal #modal-title { text-style: bold; margin-bottom: 1; }
ImportAddressModal Label        { color: $text-muted; }
ImportAddressModal Input        { margin-bottom: 1; }
ImportAddressModal #buttons     { align: right middle; height: auto; margin-top: 1; }
ImportAddressModal Button       { margin-left: 1; }

/* ── MnemonicModal ───────────────────────────────────────── */

MnemonicModal { align: center middle; }
MnemonicModal #dialog {
    width: 64;
    height: auto;
    border: thick $warning;
    background: $surface;
    padding: 1 2;
}
MnemonicModal #modal-title { text-style: bold; margin-bottom: 1; }
MnemonicModal #warning     { color: $warning; margin-bottom: 1; }
MnemonicModal #mnemonic    { text-style: bold; margin-bottom: 1; }
MnemonicModal #buttons     { align: center middle; height: auto; margin-top: 1; }

/* ── ChooserModal ────────────────────────────────────────── */

ChooserModal { align: center middle; }
ChooserModal #dialog {
    width: 50;
    height: auto;
    max-height: 20;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}
ChooserModal #title    { text-style: bold; margin-bottom: 1; }
ChooserModal ListView  { height: auto; max-height: 12; border: solid $accent; }
ChooserModal #buttons  { align: right middle; height: auto; margin-top: 1; }
ChooserModal Button    { margin-left: 1; }

/* ── ConfigPickerModal ───────────────────────────────────── */

ConfigPickerModal { align: center middle; }
ConfigPickerModal #dialog {
    width: 70;
    height: auto;
    max-height: 40;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}
ConfigPickerModal #dialog-title  { text-style: bold; margin-bottom: 1; }
ConfigPickerModal DirectoryTree  { height: 20; border: solid $accent; margin-top: 1; }
ConfigPickerModal #selected-path { color: $accent; margin-top: 1; height: 1; }
ConfigPickerModal #buttons       { align: right middle; height: auto; margin-top: 1; }
ConfigPickerModal Button         { margin-left: 1; }

/* ── ReadsScreen ─────────────────────────────────────── */

ReadsScreen {
    layout: vertical;
    height: 1fr;
    padding: 0 1;
}

#reads_body {
    height: 1fr;
    layout: vertical;
}

#cmd_row {
    height: auto;
    align: center middle;
    padding: 1 0;
}

#cmd_row Select {
    width: 50;
}

#action_row {
    layout: horizontal;
    height: auto;
    align: left middle;
    padding: 0 0 1 0;
}

#btn_args {
    width: auto;
    margin-right: 1;
}

#status_lbl {
    width: 1fr;
    padding: 0 1;
}

#status_lbl.status-ready {
    color: $success;
}

#status_lbl.status-incomplete {
    color: $warning;
    text-style: italic;
}

#btn_reset {
    width: auto;
    margin-right: 1;
}

#btn_run {
    width: auto;
}

#result_status_lbl {
    height: 1;
    padding: 0 1;
}

#result_status_lbl.result-success {
    color: $success;
}

#result_status_lbl.result-error {
    color: $error;
}

#result_text {
    border: solid $primary;
    height: 1fr;
}

#export_row {
    height: auto;
    align: center middle;
    margin-top: 1;
}

#btn_copy {
    width: auto;
    margin-right: 2;
}

#btn_save_file {
    width: auto;
}

#next_row {
    height: 3;
    margin-top: 1;
    margin-bottom: 1;
}

#btn_clear {
    width: auto;
}

#btn_next {
    dock: right;
    width: auto;
}

/* ── SaveModal ───────────────────────────────────────── */

SaveModal {
    align: center middle;
}

#save_dialog {
    width: 80;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1;
}

#save_title {
    text-style: bold;
    text-align: center;
    color: $primary;
    margin-bottom: 1;
}

#dir_tree {
    height: 20;
    border: solid $accent;
    margin-bottom: 1;
}

#save_filename_row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

#save_filename_row Label {
    width: auto;
    padding: 0 1;
}

#save_filename_row Input {
    width: 1fr;
}

#save_buttons {
    height: auto;
    align: right middle;
}

#save_buttons Button {
    margin-left: 1;
}

/* ── Arg widgets ─────────────────────────────────────── */

PlainInput {
    height: auto;
    width: 1fr;
}

PlainInput > Horizontal {
    height: auto;
    width: 1fr;
    align: left middle;
}

PlainInput Label {
    width: auto;
    padding: 0 1;
}

PlainInput Input {
    width: 1fr;
}

MultiValueInput {
    height: auto;
    width: 1fr;
}

MultiValueInput > Horizontal {
    height: auto;
    width: 1fr;
    align: left middle;
}

MultiValueInput Label {
    width: auto;
    padding: 0 1;
}

MultiValueInput Input {
    width: 1fr;
}

AddressSelect {
    height: auto;
    width: 1fr;
}

AddressSelect > Horizontal {
    height: auto;
    width: 1fr;
    align: left middle;
}

AddressSelect Label {
    width: auto;
    padding: 0 1;
}

AddressSelect Select {
    width: 1fr;
}

AddressSelect #other_inp {
    width: 1fr;
}

ObjectSelect {
    height: auto;
    width: 1fr;
}

ObjectSelect > Horizontal {
    height: auto;
    width: 1fr;
    align: left middle;
}

ObjectSelect Label {
    width: auto;
    padding: 0 1;
}

ObjectSelect Select {
    width: 1fr;
}

ObjectSelect #other_inp {
    width: 1fr;
}

ObjectChecklist {
    height: auto;
    max-height: 10;
    border: solid $accent;
    padding: 0 1;
}

ObjectChecklist #checklist {
    height: auto;
    max-height: 6;
}

ObjectChecklist Horizontal {
    height: auto;
    width: 1fr;
    align: left middle;
}

ObjectChecklist #other_inp {
    width: 1fr;
}

ForVersionsWidget {
    height: auto;
    width: 1fr;
    border: solid $accent;
    padding: 0 1;
}

ForVersionsWidget Horizontal {
    height: auto;
    width: 1fr;
    align: left middle;
}

ForVersionsWidget #obj_sel {
    width: 1fr;
}

ForVersionsWidget #other_inp {
    width: 1fr;
}

ForVersionsWidget #versions_inp {
    width: 20;
}

/* ── DefaultSelect ───────────────────────────────────── */

DefaultSelect {
    height: auto;
    width: 1fr;
}

DefaultSelect > Horizontal {
    height: auto;
    width: 1fr;
    align: left middle;
}

DefaultSelect Label {
    width: auto;
    padding: 0 1;
}

DefaultSelect Select {
    width: 1fr;
}

DefaultSelect #other_inp {
    width: 1fr;
}

/* ── BoolToggle ──────────────────────────────────────── */

BoolToggle {
    height: auto;
    width: 1fr;
}

BoolToggle > Horizontal {
    height: auto;
    width: 1fr;
    align: left middle;
}

BoolToggle Label {
    width: auto;
    padding: 0 1;
}

/* ── MultipleRow ─────────────────────────────────────── */

MultipleRow {
    height: auto;
    width: 1fr;
}

MultipleRow > Horizontal {
    height: auto;
    width: 1fr;
    align: left middle;
}

MultipleRow Label {
    width: auto;
    padding: 0 1;
}

/* ── ArgsModal ───────────────────────────────────────── */

ArgsModal { align: center middle; }

ArgsModal #args_dialog {
    width: 80%;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

ArgsModal #modal_title {
    text-style: bold;
    text-align: center;
    color: $primary;
    margin-bottom: 1;
}

ArgsModal #args_scroll {
    width: 1fr;
    height: auto;
    max-height: 36;
}

ArgsModal #modal_buttons {
    align: right middle;
    height: auto;
    margin-top: 1;
}

ArgsModal #modal_buttons Button { margin-left: 1; }

/* ── CollectorModal ──────────────────────────────────── */

CollectorModal { align: center middle; }

CollectorModal #collector_dialog {
    width: 72;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

CollectorModal #collector_title {
    text-style: bold;
    text-align: center;
    color: $primary;
    margin-bottom: 1;
}

CollectorModal #entries_scroll {
    height: auto;
    max-height: 14;
    border: solid $accent;
}

CollectorModal #staging_area {
    height: auto;
    margin-top: 1;
    border: solid $primary-darken-2;
    padding: 0 1 1 1;
}

CollectorModal .staging_label {
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

CollectorModal .staging_row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

CollectorModal .staging_row Label {
    width: 16;
    padding: 0 1;
}

CollectorModal .staging_row Input {
    width: 42;
}

CollectorModal #collector_add_buttons {
    height: auto;
    align: left middle;
    margin-top: 1;
}

CollectorModal #collector_add_buttons Button { margin-right: 1; }

CollectorModal #collector_buttons {
    align: right middle;
    height: auto;
    margin-top: 1;
}

CollectorModal #collector_buttons Button { margin-left: 1; }
